# Contact form (src/app/contact/actions.ts). Set these in Vercel for
# Production and Preview, and in .env.local to test locally.
RESEND_API_KEY=
# Where inquiries go. Several addresses can be separated by commas.
CONTACT_TO=
# Optional: a sender on a domain verified in Resend, e.g.
# "Arrowleaf website <hello@arrowleafmarketing.com>". Without it, Resend's
# test sender is used, which only delivers to the Resend account's own email.
RESEND_FROM=
# Optional: GoHighLevel inbound webhook, to drop each inquiry into the CRM.
GHL_WEBHOOK_URL=
